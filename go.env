# Project-local Go toolchain. Source this, or use ./bin/go and ./bin/gofmt.
export GOROOT="$PWD/.toolchain/go"
export GOPATH="$PWD/.toolchain/gopath"
export GOMODCACHE="$PWD/.toolchain/gopath/pkg/mod"
export GOCACHE="$PWD/.toolchain/gocache"
export GOFLAGS="-mod=mod"
export GOTOOLCHAIN="local"
export PATH="$GOROOT/bin:$GOPATH/bin:$PATH"
